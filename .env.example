# Copy to `.env`; unset variables fall back to the defaults shown here.

# --- Worker LLM (Inspector / PatchGenerator / Verifier / Judge) ---
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
MAX_TOKENS_PER_CALL=4096
TEMPERATURE=0.0
# Per-request timeout (s) for every LLM call.
LLM_REQUEST_TIMEOUT=120

# --- Controller LLM (--controller-mode llm; defaults to the OPENAI_* values) ---
CONTROLLER_API_KEY=token-or-empty
CONTROLLER_MODEL=Qwen/Qwen3.5-4B
# EasyR1 actor init (HF id or local path); unset = the EasyR1 config's model.
CONTROLLER_MODEL_PATH=Qwen/Qwen3.5-4B
CONTROLLER_BASE_URL=http://127.0.0.1:8000/v1
CONTROLLER_MAX_TOKENS=1024
CONTROLLER_TEMPERATURE=0.2
# Check Qwen3.5 loads in Transformers/vLLM/EasyR1 before a GRPO launch.
QWEN35_PREFLIGHT=1

# --- Repair loop / worker budgets ---
MAX_ITERATIONS=3
AGENT_TIMEOUT=300
INSPECTOR_MAX_TOOL_CALLS=8
INSPECTOR_READ_MAX_LINES=400
INSPECTOR_READ_MAX_CHARS=20000

# --- Environment / logging ---
WORKSPACE_DIR=./workspace
LOG_LEVEL=INFO

# --- Benchmark data and container evaluation ---
SWEBENCH_DATA_DIR=./benchmarks
# Per-instance eval timeout (s) for the container backends.
SWEBENCH_EVAL_TIMEOUT=1800
# Timeout (s) for the train-time F2P subset gate.
SWEBENCH_SUBSET_TIMEOUT=600
# Cache of eval outcomes keyed by patch content; "off" disables.
SELF_EVOLVER_EVAL_CACHE_DIR=~/.cache/self_evolver/eval_cache
# 1 = own checkout per GRPO sample (concurrent); 0 = serial per instance.
SELF_EVOLVER_PARALLEL_SAMPLES=1
# 1 = F2P subset gate on non-final eval attempts too (changes the eval protocol).
SELF_EVOLVER_EVAL_SUBSET_GATE=0
# 1 = skip the P2P suite when the F2P subset already failed (same reward).
SELF_EVOLVER_F2P_ONLY_ON_FAILED_SUBSET=1
# Adaptive eval timeout: clamp(FACTOR x slowest observed run, FLOOR, default).
SELF_EVOLVER_ADAPTIVE_TIMEOUT=1
SELF_EVOLVER_ADAPTIVE_TIMEOUT_FACTOR=4
SELF_EVOLVER_ADAPTIVE_TIMEOUT_FLOOR=180
SIF_CACHE_DIR=~/.cache/self_evolver/sif
# Official Docker-harness per-instance timeout (s).
DOCKER_TIMEOUT=600
# Frozen eval: 0 = pass@1; 1 = hidden tests steer up to 3 retries (oracle pass@3).
SELF_EVOLVER_EVAL_ORACLE_VERIFIER=0

# --- Online RL reward (src/reward/online_reward.py:compute_score) ---
SELF_EVOLVER_TEST_BACKEND=apptainer
SELF_EVOLVER_REWARD_CONFIG=configs/reward_config.yaml
SELF_EVOLVER_ROLLOUT_JSONL=benchmark_results/online_rollouts.jsonl
PATCH_GENERATOR_MAX_TOOL_CALLS=2
SELF_EVOLVER_REWARD_WORKSPACE=./workspace/online_reward
# Remove auto-created per-instance checkouts after their rollouts finish.
SELF_EVOLVER_CLEANUP_REWARD_WORKSPACES=1
# Hard-case buffer shared by reward workers, prompt retrieval and the Reflector.
SELF_EVOLVER_HARD_CASES_PATH=./workspace/online_reward/hard_cases.jsonl
SELF_EVOLVER_CLUSTER_REGISTRY=./workspace/online_reward/cluster_registry.json
SELF_EVOLVER_CLUSTER_BASELINES=./workspace/online_reward/cluster_baselines.json
# Parallel reward episodes (each GRPO sample has its own checkout).
SELF_EVOLVER_REWARD_WORKERS=8
SELF_EVOLVER_ENABLE_SKILL_EVOLUTION=0
# Skill-credit round key; scripts/tools/grpo_round.sh sets it from ROUND_ID.
SELF_EVOLVER_ROUND_ID=
ENABLE_SKILL_CREDIT=1
ENABLE_SKILL_REFLECTION=1
REFLECT_MIN_CLUSTER_SIZE=3

# --- Failure-cluster embeddings (unset = lexical fallback, no network) ---
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Skill bank dir (default ./skills, the seed bank).
SELF_EVOLVER_SKILLS_DIR=

# --- Ablation switches (README "消融") ---
# F2P subset gate during training (1 = on).
SELF_EVOLVER_TRAIN_SUBSET_GATE=1
# Failure clustering levels (2 = mechanism bucket + complete-link, 1 = one level).
SELF_EVOLVER_CLUSTER_LEVELS=2
# Task sampling: u_f = 50% unseen + 50% failure replay; legacy = old.
SELF_EVOLVER_SAMPLING_MODE=u_f
